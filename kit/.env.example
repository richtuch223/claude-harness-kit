# Copy to .env (git-ignored) and fill in. The tools read the ENVIRONMENT, they do not load this file: export it
# (`set -a; . ./.env; set +a` in bash, or your direnv/dotenv of choice) before running them. Never hardcode a key.

# Heavy-data root (default: ./data_local, git-ignored)
DATA_ROOT=

# Cross-family review gate (tools/verify.py). Pick ONE route; see .claude/skills/cross-review/SKILL.md.
VERIFY_PROVIDER=           # codex-cli (default, ChatGPT OAuth, no key) | gemini | gemini-cli | openrouter | deepseek | groq | local
GEMINI_API_KEY=            # free at aistudio.google.com  ->  -p gemini
OPENROUTER_API_KEY=        # pay-as-you-go               ->  -p openrouter

# Web scout on the Codex seat (tools/codex_scout.py). A probed model id; see 05_CODEX_ON_TOP.md §5.
CODEX_SCOUT_MODEL=
